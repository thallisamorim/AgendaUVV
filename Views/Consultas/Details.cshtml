@model AgendaUVV.Models.Consulta

@{
    ViewData["Title"] = "Detalhes da Consulta";
}

<h2>Detalhes da Consulta</h2>

<div class="card p-4 mt-3" style="max-width: 600px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Especialidade</dt>
        <dd class="col-sm-8">@Model.Especialidade</dd>

        <dt class="col-sm-4">Data e Hora</dt>
        <dd class="col-sm-8">@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-4">Descrição</dt>
        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Descricao) ? "Não informada" : Model.Descricao)</dd>
    </dl>

    <div class="d-flex justify-content-between mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    </div>
</div>