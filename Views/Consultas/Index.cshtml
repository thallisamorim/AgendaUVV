@model IEnumerable<AgendaUVV.Models.Consulta>

@{
    ViewData["Title"] = "Minhas Consultas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Minhas Consultas</h2>
    <a asp-action="Create" class="btn btn-primary">Nova Consulta</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Você ainda não tem nenhuma consulta cadastrada.
    </div>
}
else
{
    <div class="card">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Especialidade</th>
                    <th>Data e Hora</th>
                    <th>Descrição</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var consulta in Model)
                {
                    <tr>
                        <td>@consulta.Especialidade</td>
                        <td>@consulta.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@consulta.Descricao</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@consulta.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@consulta.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@consulta.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}